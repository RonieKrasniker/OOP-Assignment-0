# Force LF line endings on all text files, regardless of core.autocrlf.
# Binary files (jars, images, etc.) are auto-detected and not converted.
* text=auto eol=lf

# Explicit overrides for shell scripts and patterns where auto-detection
# might be ambiguous. These ensure tooling sees consistent LF.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xsl text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
io text eol=lf
